// Cloudflare Worker settings for Workers Builds (Workers & Pages > Create > Import a repository).
// Build command: bun run build   Deploy command: npx wrangler deploy
{
  "name": "boxedbydweenie",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [{ "type": "ESModule", "globs": ["**/*.mjs", "**/*.js"] }],
  "assets": { "binding": "ASSETS", "directory": ".output/public" },
  "observability": { "enabled": true }
}
